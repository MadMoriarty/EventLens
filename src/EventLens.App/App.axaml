<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:EventLens.App" x:Class="EventLens.App.App" RequestedThemeVariant="Dark">
 <Application.Resources><local:LiveRowColor x:Key="LiveRowColor"/><local:SeverityColor x:Key="SeverityColor"/></Application.Resources>
 <Application.Styles>
  <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#289FC1"/><ColorPaletteResources x:Key="Light" Accent="#167F9E"/></FluentTheme.Palettes></FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
  <Style Selector="Window"><Setter Property="Background" Value="#141519"/><Setter Property="Foreground" Value="#DEDFE5"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="29"/><Setter Property="Padding" Value="10,5"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="#24262D"/><Setter Property="BorderBrush" Value="#34363F"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Button.accent"><Setter Property="Background" Value="#289FC1"/><Setter Property="Foreground" Value="#101A20"/><Setter Property="BorderBrush" Value="#59B8D3"/></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="#1B1D23"/><Setter Property="BorderBrush" Value="#353740"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="#1B1D23"/><Setter Property="BorderBrush" Value="#353740"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8E929F"/></Style>
  <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#8E929F"/><Setter Property="FontSize" Value="10"/><Setter Property="LetterSpacing" Value="1.1"/></Style>
  <Style Selector="DataGrid"><Setter Property="Background" Value="#17181D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="33"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="FontSize" Value="12"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
  <Style Selector="DataGridCell"><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="DataGridCell TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{Binding Converter={StaticResource SeverityColor}}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style>
  <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="#1E2026"/><Setter Property="Foreground" Value="#9DA1AD"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="9,8"/></Style>
  <Style Selector="TabControl"><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="TabItem"><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,9"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style Selector="DataGridRow"><Setter Property="Foreground" Value="{Binding Converter={StaticResource SeverityColor}}"/><Setter Property="Background" Value="{Binding Converter={StaticResource LiveRowColor}}"/></Style>
  <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="ListBox.nav ListBoxItem"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="CornerRadius" Value="4"/></Style>
 </Application.Styles>
</Application>
