<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="EventLens.App.MainWindow" Title="EventLens" Icon="avares://EventLens/Assets/EventLens.ico" Width="1560" Height="960" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="NoChrome" ExtendClientAreaTitleBarHeightHint="42" SystemDecorations="BorderOnly">
 <Grid RowDefinitions="42,*,30">
  <Border Grid.Row="0" Background="#1B1C22" BorderBrush="#2C2E36" BorderThickness="0,0,0,1" PointerPressed="TitlePointerPressed">
   <Grid ColumnDefinitions="94,*,Auto" Margin="16,0">
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button Width="13" Height="13" MinHeight="0" Padding="0" CornerRadius="7" Background="#ED829F" BorderThickness="0" Click="CloseClick" ToolTip.Tip="Close EventLens" AutomationProperties.Name="Close EventLens"/>
     <Button Width="28" Height="13" MinHeight="0" Padding="0" CornerRadius="7" Background="#DCA16A" BorderThickness="0" Click="MinimizeClick" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize EventLens"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="EVENTLENS" FontWeight="SemiBold" LetterSpacing="2" FontSize="11"/><TextBlock Text="/" Foreground="#505461"/><TextBlock Text="Windows event investigator" Classes="muted" FontSize="11"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="LOCAL-FIRST · READ-ONLY" Classes="caption" VerticalAlignment="Center"/><Button Content="Sources" Click="SourcesClick"/><Button Content="Open EVTX" Click="ImportClick"/><Button Content="About" Click="AboutClick"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="206,4,*,4,362">
   <Border Grid.Column="0" Background="#191A20" Padding="12,18,10,12" x:Name="NavPanel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
     <TextBlock Text="INVESTIGATE" Classes="caption" Margin="12,0,0,12"/>
     <ListBox Grid.Row="1" x:Name="NavigationList" Classes="nav" ItemsSource="{Binding Navigation}" SelectedItem="{Binding Section, Mode=OneWay}" SelectionChanged="NavigationChanged"/>
     <StackPanel Grid.Row="3" Spacing="8" Margin="10"><TextBlock Text="SOURCE SCOPE" Classes="caption"/><TextBlock Text="{Binding SourcesLabel}" TextWrapping="Wrap" Classes="muted" FontSize="11"/><TextBlock Text="No services. No telemetry. No cloud." Classes="muted" FontSize="10" Margin="0,10,0,0"/><Button Content="Keyboard shortcuts" Click="ShortcutsClick" HorizontalAlignment="Left"/><Button Content="References &amp; troubleshooting" Click="CoverageClick" FontSize="10" HorizontalAlignment="Left"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Background="#2C2E36" ResizeDirection="Columns"/>
   <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="18,17,16,12"><StackPanel><TextBlock Text="{Binding Section}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Scope}" Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,5,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top"><Button Content="Groups" Click="GroupsClick"/><Button Content="Correlate" Click="CorrelateClick"/><Button x:Name="ExportEventsButton" Content="Export events ▾" ToolTip.Tip="Export the displayed page, all matching records, or a native source EVTX"><Button.Flyout><MenuFlyout><MenuItem Header="Export displayed page as CSV…" Click="ExportCsvClick"/><MenuItem Header="Export displayed page as JSON…" Click="ExportJsonClick"/><Separator/><MenuItem Header="Export ALL matching events as JSON…" Click="ExportAllJsonClick"/><MenuItem Header="Export ALL matches as CSV bundle…" Click="ExportAllCsvClick"/><MenuItem Header="Export source as native EVTX…" Click="ExportNativeClick"/></MenuFlyout></Button.Flyout></Button><Button Content="Panels" Click="PanelsClick"/></StackPanel></Grid>
    <Border Grid.Row="1" Margin="16,0,16,10" Padding="10,7" Background="#1D1F26" BorderBrush="#30323C" BorderThickness="1" CornerRadius="4"><StackPanel Spacing="4"><TextBlock Text="{Binding Stats}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Origins}" Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsInvestigation}"/></StackPanel></Border>
    <StackPanel Grid.Row="2" Margin="16,0,16,10" Spacing="8">
     <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="7"><TextBox Grid.Column="0" Watermark="Username, DOMAIN\user or SID" Text="{Binding Identity}" AutomationProperties.Name="User identity"/><TextBox Grid.Column="1" Watermark="Text, IP, host, status code…" Text="{Binding Text}" x:Name="SearchText" AutomationProperties.Name="Search event text"/><Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Classes="accent" IsEnabled="{Binding IsIdle}"/><Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/></Grid>
     <WrapPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="150" Margin="0,0,7,4" AutomationProperties.Name="Time range"/><ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" Width="155" Margin="0,0,7,4" AutomationProperties.Name="Severity"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Width="175" Margin="0,0,7,4" AutomationProperties.Name="Event category"/><Button Content="Guided investigations…" Click="GuidedClick" Margin="0,0,7,4"/><Button Content="Advanced filters" Click="FiltersClick" Margin="0,0,0,4"/></WrapPanel>
     <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCustomTime}"><TextBox Watermark="Start UTC · 2026-10-22T08:00:00Z" Text="{Binding CustomFrom}"/><TextBox Grid.Column="1" Watermark="End UTC" Text="{Binding CustomTo}"/></Grid>
     <Expander x:Name="AdvancedFilters" Header="Provider, event IDs and source filters" IsExpanded="False" IsVisible="False"><StackPanel Spacing="7" Margin="0,8,0,0"><Grid ColumnDefinitions="*,*" ColumnSpacing="7"><TextBox Watermark="Event IDs, comma separated" Text="{Binding Ids}"/><TextBox Grid.Column="1" Watermark="Exact provider name" Text="{Binding Provider}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="7"><TextBox Watermark="Recorded computer / DC" Text="{Binding Computer}"/><TextBox Grid.Column="1" Watermark="Origin workstation / IP" Text="{Binding Origin}"/></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="7"><TextBox Watermark="Authentication protocol" Text="{Binding Protocol}"/><TextBox Grid.Column="1" Watermark="Failure reason" Text="{Binding Failure}"/></Grid></StackPanel></Expander>
    </StackPanel>
    <Grid Grid.Row="3" Margin="16,0,16,9" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"><TextBox Watermark="Name this filter to save it" Text="{Binding SearchName}"/><Button Grid.Column="1" Content="Save search" Click="SaveSearchClick"/><Button Grid.Column="2" Content="Columns" Click="ColumnsClick"/></Grid>
    <Border Grid.Row="4" Margin="16,0,16,8" IsVisible="{Binding IsSaved}" Background="#1D1F26" Padding="10"><StackPanel Spacing="8"><ComboBox ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSaved}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Run saved search" Click="ApplySavedClick"/><Button Content="Remove filter" Click="RemoveSavedClick"/></StackPanel></StackPanel></Border>
    <DataGrid Grid.Row="5" x:Name="ResultsGrid" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserReorderColumns="True" CanUserSortColumns="True" SelectionMode="Single" BorderThickness="0">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Timestamp (local)" Binding="{Binding TimestampDisplay}" SortMemberPath="Timestamp" Width="175"/>
      <DataGridTemplateColumn Header="Severity" SortMemberPath="Severity" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Severity}" Foreground="{Binding Converter={StaticResource SeverityColor}}" VerticalAlignment="Center" Margin="9,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="What happened" Binding="{Binding Title}" Width="*" MinWidth="235"/>
      <DataGridTextColumn Header="User" Binding="{Binding User}" Width="115"/>
      <DataGridTextColumn Header="Computer" Binding="{Binding Computer}" Width="105"/>
      <DataGridTextColumn Header="Source" Binding="{Binding Provider}" Width="145"/>
      <DataGridTextColumn Header="Event ID" Binding="{Binding Id}" Width="65"/>
      <DataGridTextColumn Header="Origin" Binding="{Binding Origin}" Width="135"/>
      <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100"/>
      <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="130"/>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="6" Margin="16,8" Spacing="5"><TextBlock Text="{Binding IdentityNotice}" Classes="muted" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding PlanStatus}" IsVisible="{Binding HasPlan}" Classes="muted" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding PageStatus}" IsVisible="{Binding HasQuery}" Classes="muted" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="{Binding Notice}" Classes="muted" FontSize="10" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"><Button Content="Previous page" Click="PreviousClick" IsEnabled="{Binding CanPrevious}"/><Button Content="Next page" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" IsEnabled="{Binding IsIdle}"/><Button x:Name="ScanAllButton" Content="Scan all matches" Click="ScanAllClick" IsEnabled="{Binding IsIdle}"/></StackPanel></Grid><Expander Header="Source notices and access errors"><ItemsControl ItemsSource="{Binding SourceNotices}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#E7B68A" FontSize="11" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel>
    <Border Grid.Row="7" BorderBrush="#30323A" BorderThickness="0,1,0,0" Padding="16,9" Background="#1B1D23"><StackPanel Spacing="6"><WrapPanel><Button Content="{Binding WatchLabel}" Command="{Binding WatchCommand}" Margin="0,0,7,0" IsEnabled="{Binding IsIdle}"/><Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}" IsEnabled="{Binding IsWatching}" Margin="0,0,12,0"/><Button Content="Recover live" Click="RecoverLiveClick" IsEnabled="{Binding IsWatching}" Margin="0,0,8,0"/><CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" Margin="0,0,12,0"/><CheckBox Content="Sound" IsChecked="{Binding Sound}"/></WrapPanel><TextBlock Text="{Binding LiveStatus}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
   </Grid>
   <GridSplitter Grid.Column="3" Background="#2C2E36" ResizeDirection="Columns"/>
   <Border Grid.Column="4" x:Name="DetailsPanel" Background="#1A1C22" Padding="16,18,16,12"><Grid RowDefinitions="Auto,Auto,*"><TextBlock Text="EVENT DETAILS" Classes="caption"/><TextBlock Grid.Row="1" Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,14"/>
    <TabControl Grid.Row="2"><TabItem Header="Explain"><ScrollViewer><StackPanel Spacing="14" Margin="0,12,4,0"><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" LineHeight="19"/><Button Content="Troubleshooting &amp; references →" Click="ShowGuidanceClick" HorizontalAlignment="Left"/><TextBlock Text="RECORDED CODES" Classes="caption"/><SelectableTextBlock Text="{Binding CodeDetails}" TextWrapping="Wrap" FontSize="11"/><Border Height="1" Background="#343640"/><SelectableTextBlock Text="{Binding Metadata}" TextWrapping="Wrap" FontSize="11" Foreground="#AAAFBC"/><Button Content="Copy explanation and metadata" Click="CopyDetailsClick"/><Button Content="Export selected event" Click="ExportSelectedClick"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Help" x:Name="TroubleshootingTab"><ScrollViewer><StackPanel Spacing="13" Margin="0,12,4,0"><SelectableTextBlock x:Name="GuidanceText" Text="{Binding GuidanceText}" TextWrapping="Wrap" FontSize="12"/><Button Content="Copy troubleshooting and references" Click="CopyGuidanceClick"/><TextBlock Text="REFERENCES" Classes="caption"/><TextBlock Text="External links open in your browser when clicked. Event contents are not included." Classes="muted" FontSize="10" TextWrapping="Wrap"/><ItemsControl x:Name="ReferenceLinks" ItemsSource="{Binding ReferenceLinks}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="5" Margin="0,4,0,14"><TextBlock Text="{Binding Source}" FontWeight="SemiBold" Foreground="#83C9DE"/><Button Click="ReferenceClick" Tag="{Binding Url}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding Url}"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/></Button><TextBlock Text="{Binding Scope}" TextWrapping="Wrap" Classes="muted" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem><TabItem Header="Payload"><TextBox Text="{Binding RawProperties}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas" FontSize="11" BorderThickness="0" Margin="0,10,0,0"/></TabItem><TabItem Header="XML"><Grid RowDefinitions="Auto,*"><Button Content="Copy XML" Click="CopyXmlClick" HorizontalAlignment="Left" Margin="0,10,0,8"/><TextBox Grid.Row="1" Text="{Binding RawXml}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas" FontSize="11" BorderThickness="0" TextWrapping="NoWrap"/></Grid></TabItem><TabItem Header="Original"><TextBox Text="{Binding Original}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Margin="0,10,0,0"/></TabItem></TabControl>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Background="#1B1C22" BorderBrush="#2C2E36" BorderThickness="0,1,0,0" Padding="15,0"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="EventLens 1.3 · Local Windows authentication · No event logs modified" Classes="muted" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Ctrl+F  search     Ctrl+R  refresh     Ctrl+O  open EVTX     Esc  cancel" Classes="muted" FontSize="10" VerticalAlignment="Center"/></Grid></Border>
 </Grid>
</Window>
